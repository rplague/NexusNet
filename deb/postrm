#!/bin/sh
# @BIN@ deb 包 postrm（卸载后）
# 参数:
#   remove       常规卸载
#   upgrade      升级
#   purge        彻底清除（dpkg -P）
# 注意：不删除 /var/lib/@PKG@ 下的运行数据（含 keypair.bin）；也不删除 @USER@ 账号
#       日志由 journald 管理，不在此处理。
set -e

UNIT_NAME="@PKG@"
PKG="@PKG@"
CONFIG_DIR="/etc/${PKG}"

case "$1" in
    remove|upgrade|abort-install|abort-upgrade|disappear)
        systemctl daemon-reload >/dev/null 2>&1 || true
        ;;
    purge)
        if [ -f /usr/share/debconf/confmodule ]; then
            . /usr/share/debconf/confmodule
            db_purge >/dev/null 2>&1 || true
            db_stop >/dev/null 2>&1 || true
        fi
        rm -f \
            "${CONFIG_DIR}/config.toml" \
            "${CONFIG_DIR}/config.schema" \
            "${CONFIG_DIR}/config.toml.tmp"
        if [ -d "${CONFIG_DIR}" ]; then
            for _backup in "${CONFIG_DIR}"/config.toml.bak.*; do
                [ -e "${_backup}" ] || continue
                rm -f "${_backup}"
            done
            rmdir "${CONFIG_DIR}" 2>/dev/null || true
        fi
        systemctl daemon-reload >/dev/null 2>&1 || true
        ;;
esac

exit 0
