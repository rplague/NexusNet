#!/bin/sh
# @BIN@ deb 包 postrm（卸载后）
# 参数:
#   remove       常规卸载
#   upgrade      升级
#   purge        彻底清除（dpkg -P）
# 注意：不删除 /var/lib/@PKG@ 下的运行数据（含 keypair.bin）；也不删除 @USER@ 账号
#       日志由 journald 管理，不在此处理。
set -e

UNIT_NAME="@PKG@"

case "$1" in
    remove|upgrade|abort-install|abort-upgrade|disappear|purge)
        systemctl daemon-reload >/dev/null 2>&1 || true
        ;;
esac

exit 0
