#!/bin/sh
set -e

. /usr/share/debconf/confmodule

USER_NAME="@USER@"
UNIT_NAME="@PKG@"
BIN_NAME="@BIN@"
PKG="@PKG@"
CONFIG="/etc/${PKG}/config.toml"
CONFIG_SCHEMA_FILE="/etc/${PKG}/config.schema"
CURRENT_SCHEMA=@CONFIG_SCHEMA@
BREAKING_BELOW=@BREAKING_BELOW@

create_system_user() {
    if id "${USER_NAME}" >/dev/null 2>&1; then
        return 0
    fi
    if ! command -v useradd >/dev/null 2>&1; then
        echo "NexusNet: useradd 不存在，无法创建 ${USER_NAME} 用户" >&2
        return 1
    fi
    useradd --system --user-group --no-create-home --shell /usr/sbin/nologin "${USER_NAME}" || {
        echo "NexusNet: 创建用户 ${USER_NAME} 失败" >&2
        return 1
    }
}

create_dirs() {
    install -d -m 0755 -o "${USER_NAME}" -g "${USER_NAME}" /etc/"${PKG}" || return 1
    install -d -m 0700 -o "${USER_NAME}" -g "${USER_NAME}" /var/lib/"${PKG}" || return 1
}

systemd_available() {
    command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]
}

restart_unit() {
    systemctl enable "${UNIT_NAME}" || return 1
    systemctl restart "${UNIT_NAME}" || return 1
    sleep 1
    if ! systemctl is-active --quiet "${UNIT_NAME}"; then
        echo "NexusNet: ${UNIT_NAME} 启动后未处于 active 状态" >&2
        journalctl -u "${UNIT_NAME}" -n 20 --no-pager >&2 2>/dev/null || true
        return 1
    fi
}

read_installed_schema() {
    if [ ! -f "${CONFIG_SCHEMA_FILE}" ]; then
        printf '0'
        return 0
    fi
    _value="$(cat "${CONFIG_SCHEMA_FILE}" 2>/dev/null || printf '0')"
    case "${_value}" in
        ''|*[!0-9]*) printf '0' ;;
        *) printf '%s' "${_value}" ;;
    esac
}

write_installed_schema() {
    printf '%s\n' "$1" > "${CONFIG_SCHEMA_FILE}" || return 1
    chown "${USER_NAME}":"${USER_NAME}" "${CONFIG_SCHEMA_FILE}" 2>/dev/null || true
    chmod 0644 "${CONFIG_SCHEMA_FILE}" 2>/dev/null || true
}

ensure_persistent_journal() {
    if [ ! -d /var/log/journal ]; then
        mkdir -p /var/log/journal 2>/dev/null || return 0
        chown root:systemd-journal /var/log/journal 2>/dev/null || true
        chmod 2755 /var/log/journal 2>/dev/null || true
        systemctl restart systemd-journald >/dev/null 2>&1 || true
    fi
}

json_escape() {
    printf '%s' "$1" | tr '\n\r' '  ' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g'
}

json_bool() {
    case "$1" in
        true|TRUE|1|yes|on) printf 'true' ;;
        *) printf 'false' ;;
    esac
}

json_num() {
    case "$1" in
        ''|*[!0-9]*) printf '%s' "$2" ;;
        *) printf '%s' "$1" ;;
    esac
}

json_csv() {
    _in="$1"
    _out=""
    _first=1
    _oldifs="$IFS"
    IFS=','
    for _item in $_in; do
        _item=$(printf '%s' "$_item" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        [ -z "$_item" ] && continue
        _esc=$(json_escape "$_item")
        [ "$_first" -eq 0 ] && _out="${_out},"
        _out="${_out}\"${_esc}\""
        _first=0
    done
    IFS="$_oldifs"
    printf '[%s]' "$_out"
}

json_services() {
    _in="$1"
    _out=""
    _first=1
    _oldifs="$IFS"
    IFS=','
    for _item in $_in; do
        _item=$(printf '%s' "$_item" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        [ -z "$_item" ] && continue
        _name="${_item%%:*}"
        _rest="${_item#*:}"
        _port="${_rest%%:*}"
        _after=""
        if [ "$_rest" != "$_port" ]; then
            _after="${_rest#*:}"
        fi
        _auth=""
        _publish="1"
        if [ -n "$_after" ]; then
            _auth="${_after%%:*}"
            if [ "$_after" != "$_auth" ]; then
                _publish="${_after#*:}"
            fi
        fi
        _port=$(json_num "$_port" 0)
        _req=false
        case "$_auth" in
            1|true|TRUE|yes|on) _req=true ;;
        esac
        _pub=true
        case "$_publish" in
            0|false|FALSE|no|off) _pub=false ;;
        esac
        _name=$(json_escape "$_name")
        [ "$_first" -eq 0 ] && _out="${_out},"
        _out="${_out}{\"name\":\"${_name}\",\"port\":${_port},\"require_auth\":${_req},\"publish\":${_pub}}"
        _first=0
    done
    IFS="$_oldifs"
    printf '[%s]' "$_out"
}

db_get_mode() {
    db_get "${PKG}/setup_mode" || true
    MODE="${RET:-skip}"
    case "${MODE}" in
        wizard|skip) ;;
        *) MODE="skip" ;;
    esac
}

db_get_value() {
    db_get "${PKG}/$1" || true
    printf '%s' "${RET:-$2}"
}

db_seen() {
    db_fget "${PKG}/$1" seen || true
    [ "${RET:-false}" = "true" ]
}

case "${1:-configure}" in
    configure) ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        systemctl daemon-reload >/dev/null 2>&1 || true
        exit 0
        ;;
    *)
        exit 0
        ;;
esac

create_system_user
create_dirs
ensure_persistent_journal

WAS_ENABLED="$(systemctl is-enabled "${UNIT_NAME}" 2>/dev/null || true)"
CONFIG_EXISTS=0
if [ -f "${CONFIG}" ]; then
    CONFIG_EXISTS=1
fi

db_get_mode

CHECK_FAILED=0
CHECK_OUTPUT=""

if [ "${MODE}" = "wizard" ]; then
    NODE_NAME="$(db_get_value node_name NexusNet)"
    NODE_DESCRIPTION="$(db_get_value node_description 'NexusNet P2P node')"
    PORT="$(json_num "$(db_get_value port 5000)" 5000)"
    BOOTSTRAP="$(db_get_value bootstrap '')"
    LOCAL_SERVICES_ENABLED="$(json_bool "$(db_get_value local_services_enabled false)")"
    LOCAL_SERVICES="$(db_get_value local_services '')"
    ALLOW_BOOTSTRAP="$(json_bool "$(db_get_value allow_bootstrap true)")"
    ACCEPT_PROVIDERS="$(json_bool "$(db_get_value accept_bootstrap_providers false)")"
    PQ_TRANSPORT="$(json_bool "$(db_get_value pq_transport true)")"
    PQ_IDENTITY="$(json_bool "$(db_get_value pq_identity true)")"
    PQ_REQUIRED="$(json_bool "$(db_get_value pq_required false)")"
    AUTH_ENABLED="$(json_bool "$(db_get_value auth_enabled false)")"
    AUTH_NETWORK="$(db_get_value auth_network none)"
    AUTH_AUTHORITY="$(db_get_value auth_authority '')"
    PING_ENABLED="$(json_bool "$(db_get_value ping_enabled true)")"
    PING_INTERVAL="$(json_num "$(db_get_value ping_interval 15)" 15)"
    PING_TIMEOUT="$(json_num "$(db_get_value ping_timeout 10)" 10)"
    PING_FAILURES="$(json_num "$(db_get_value ping_failures 2)" 2)"
    KADEMLIA_ENABLED="$(json_bool "$(db_get_value kademlia_enabled true)")"
    KADEMLIA_TTL="$(json_num "$(db_get_value kademlia_ttl 3600)" 3600)"
    KADEMLIA_REPLICATION="$(json_num "$(db_get_value kademlia_replication 20)" 20)"
    KADEMLIA_TIMEOUT="$(json_num "$(db_get_value kademlia_query_timeout 60)" 60)"
    DISPATCHER_ENABLED="$(json_bool "$(db_get_value dispatcher_enabled true)")"
    DISPATCHER_TIMEOUT="$(json_num "$(db_get_value dispatcher_query_timeout 60)" 60)"
    TYPES_SYNC="$(json_num "$(db_get_value types_sync 300)" 300)"
    DISPATCHER_INFLIGHT="$(json_num "$(db_get_value dispatcher_inflight 4)" 4)"
    REQUEST_MIB="$(json_num "$(db_get_value request_mib 16)" 16)"
    RESPONSE_MIB="$(json_num "$(db_get_value response_mib 16)" 16)"
    REGISTRY_INFLIGHT="$(json_num "$(db_get_value registry_inflight 4)" 4)"
    REGISTRY_TYPE_TTL="$(json_num "$(db_get_value registry_type_ttl 1800)" 1800)"
    RELAY_RETRY="$(json_num "$(db_get_value relay_retry 60)" 60)"
    RELAY_FAILURES="$(json_num "$(db_get_value relay_failures 3)" 3)"
    COMPAT_MAX="$(json_num "$(db_get_value compat_max 14336)" 14336)"

    if [ "${LOCAL_SERVICES_ENABLED}" != "true" ]; then
        LOCAL_SERVICES=""
    fi
    if [ "${AUTH_ENABLED}" != "true" ]; then
        AUTH_NETWORK="none"
        AUTH_AUTHORITY=""
    elif [ -z "${AUTH_NETWORK}" ] || [ "${AUTH_NETWORK}" = "none" ]; then
        AUTH_NETWORK="none"
        AUTH_AUTHORITY=""
    fi
    if [ "${PQ_REQUIRED}" = "true" ]; then
        PQ_TRANSPORT="true"
    fi
    if ! db_seen registry_type_ttl; then
        _min_type_ttl=$((TYPES_SYNC * 2 + 1))
        if [ "${REGISTRY_TYPE_TTL}" -lt "${_min_type_ttl}" ]; then
            REGISTRY_TYPE_TTL="${_min_type_ttl}"
        fi
    fi

    TMPDIR="$(mktemp -d)"
    trap 'rm -rf "${TMPDIR}"' EXIT

    NODE_NAME_ESC="$(json_escape "${NODE_NAME}")"
    NODE_DESC_ESC="$(json_escape "${NODE_DESCRIPTION}")"
    BOOTSTRAP_JSON="$(json_csv "${BOOTSTRAP}")"
    SERVICES_JSON="$(json_services "${LOCAL_SERVICES}")"
    AUTH_NETWORK_ESC="$(json_escape "${AUTH_NETWORK}")"
    AUTH_AUTHORITY_ESC="$(json_escape "${AUTH_AUTHORITY}")"
    if [ "${AUTH_NETWORK}" = "none" ]; then
        AUTH_NETWORKS="{}"
    else
        AUTH_NETWORKS="{\"${AUTH_NETWORK_ESC}\":{\"authority\":\"${AUTH_AUTHORITY_ESC}\"}}"
    fi
    REQUEST_BYTES=$((REQUEST_MIB * 1048576))
    RESPONSE_BYTES=$((RESPONSE_MIB * 1048576))

    cat > "${TMPDIR}/answers.json" <<EOF
{
  "node": {
    "name": "${NODE_NAME_ESC}",
    "description": "${NODE_DESC_ESC}",
    "allow_bootstrap": ${ALLOW_BOOTSTRAP},
    "accept_bootstrap_providers": ${ACCEPT_PROVIDERS}
  },
  "network": {
    "port": ${PORT}
  },
  "services": {
    "ping": {
      "enabled": ${PING_ENABLED},
      "interval_secs": ${PING_INTERVAL},
      "with_timeout": ${PING_TIMEOUT},
      "max_failures": ${PING_FAILURES}
    },
    "kademlia": {
      "enabled": ${KADEMLIA_ENABLED},
      "record_ttl_seconds": ${KADEMLIA_TTL},
      "replication_factor": ${KADEMLIA_REPLICATION},
      "query_timeout_seconds": ${KADEMLIA_TIMEOUT},
      "bootstrap_nodes": ${BOOTSTRAP_JSON}
    },
    "dispatcher": {
      "enabled": ${DISPATCHER_ENABLED},
      "query_timeout_secs": ${DISPATCHER_TIMEOUT},
      "types_sync_secs": ${TYPES_SYNC},
      "max_inflight_dht": ${DISPATCHER_INFLIGHT},
      "max_request_bytes": ${REQUEST_BYTES},
      "max_response_bytes": ${RESPONSE_BYTES},
      "local_services": ${SERVICES_JSON}
    },
    "registry": {
      "max_inflight_dht": ${REGISTRY_INFLIGHT},
      "type_ttl_secs": ${REGISTRY_TYPE_TTL}
    },
    "relay": {
      "retry_interval_secs": ${RELAY_RETRY},
      "max_failures": ${RELAY_FAILURES}
    }
  },
  "crypto": {
    "pq_transport_enabled": ${PQ_TRANSPORT},
    "pq_identity_enabled": ${PQ_IDENTITY},
    "pq_required": ${PQ_REQUIRED}
  },
  "auth": {
    "network": "${AUTH_NETWORK_ESC}",
    "networks": ${AUTH_NETWORKS}
  },
  "compat": {
    "max_record_bytes": ${COMPAT_MAX}
  }
}
EOF

    if ! /usr/bin/"${BIN_NAME}" --write-config "${TMPDIR}/answers.json" --config-dir /etc/"${PKG}" --backup; then
        systemctl disable --now "${UNIT_NAME}" >/dev/null 2>&1 || true
        db_stop || true
        exit 1
    fi
    write_installed_schema "${CURRENT_SCHEMA}" || {
        echo "NexusNet: 写入 ${CONFIG_SCHEMA_FILE} 失败" >&2
        systemctl disable --now "${UNIT_NAME}" >/dev/null 2>&1 || true
        db_stop || true
        exit 1
    }
else
    if [ "${CONFIG_EXISTS}" -eq 0 ]; then
        if ! /usr/bin/"${BIN_NAME}" --defaults --config-dir /etc/"${PKG}"; then
            systemctl disable --now "${UNIT_NAME}" >/dev/null 2>&1 || true
            db_stop || true
            exit 1
        fi
        write_installed_schema "${CURRENT_SCHEMA}" || {
            echo "NexusNet: 写入 ${CONFIG_SCHEMA_FILE} 失败" >&2
            db_stop || true
            exit 1
        }
    else
        INSTALLED_SCHEMA="$(read_installed_schema)"
        if [ "${INSTALLED_SCHEMA}" -lt "${BREAKING_BELOW}" ]; then
            CHECK_FAILED=1
            CHECK_OUTPUT="现有配置版本 ${INSTALLED_SCHEMA} 低于最低兼容版本 ${BREAKING_BELOW}；请运行 dpkg-reconfigure ${PKG} 重新配置。"
        elif [ "${INSTALLED_SCHEMA}" -gt "${CURRENT_SCHEMA}" ]; then
            CHECK_FAILED=1
            CHECK_OUTPUT="现有配置版本 ${INSTALLED_SCHEMA} 高于当前程序支持的 ${CURRENT_SCHEMA}；请升级 NexusNet 或手动处理。"
        elif ! CHECK_OUTPUT="$(/usr/bin/"${BIN_NAME}" --check-config --config-dir /etc/"${PKG}" 2>&1)"; then
            CHECK_FAILED=1
        else
            write_installed_schema "${CURRENT_SCHEMA}" || {
                CHECK_FAILED=1
                CHECK_OUTPUT="写入 ${CONFIG_SCHEMA_FILE} 失败"
            }
        fi
    fi
fi

if [ -f "${CONFIG}" ]; then
    chown "${USER_NAME}":"${USER_NAME}" "${CONFIG}" || {
        echo "NexusNet: chown ${CONFIG} 失败" >&2
        db_stop || true
        exit 1
    }
    chmod 0644 "${CONFIG}" || {
        echo "NexusNet: chmod ${CONFIG} 失败" >&2
        db_stop || true
        exit 1
    }
fi

systemctl daemon-reload >/dev/null 2>&1 || true

if [ "${CHECK_FAILED}" -eq 1 ]; then
    systemctl disable --now "${UNIT_NAME}" >/dev/null 2>&1 || true
    db_subst "${PKG}/legacy_note" ERROR "${CHECK_OUTPUT}" || true
    db_input critical "${PKG}/legacy_note" || true
    db_go || true
elif [ "${MODE}" = "wizard" ]; then
    if systemd_available; then
        restart_unit || {
            db_stop || true
            exit 1
        }
    else
        echo "NexusNet 警告：systemd 不可用，未启动 ${UNIT_NAME}" >&2
    fi
elif [ "${MODE}" = "skip" ] && [ "${CONFIG_EXISTS}" -eq 1 ]; then
    if [ "${WAS_ENABLED}" = "enabled" ]; then
        if systemd_available; then
            restart_unit || {
                db_stop || true
                exit 1
            }
        else
            echo "NexusNet 警告：systemd 不可用，未重启 ${UNIT_NAME}" >&2
        fi
    else
        systemctl disable --now "${UNIT_NAME}" >/dev/null 2>&1 || true
    fi
else
    systemctl disable --now "${UNIT_NAME}" >/dev/null 2>&1 || true
    if [ "${MODE}" = "skip" ] && [ "${CONFIG_EXISTS}" -eq 0 ]; then
        db_input high "${PKG}/skip_note" || true
        db_go || true
    fi
fi

db_set "${PKG}/setup_mode" skip || true
db_fset "${PKG}/setup_mode" seen true || true
db_go || true
db_stop || true

exit 0
