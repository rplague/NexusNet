#!/bin/sh
# @BIN@ deb 包 postinst
# 参数:
#   $1=configure     安装 或 升级
#   $2=旧版本号       首次安装为空，升级时为被替换的版本
#
# 运行账号固定为 NexusNet 的专用用户 `nexusnet` 账号缺失时创建
set -e

USER_NAME="@USER@"
UNIT_NAME="@PKG@"

create_system_user() {
    if id "${USER_NAME}" >/dev/null 2>&1; then
        return 0
    fi
    if command -v useradd >/dev/null 2>&1; then
        useradd --system --user-group --no-create-home --shell /usr/sbin/nologin "${USER_NAME}" || true
    fi
}

create_dirs() {
    if command -v systemd-tmpfiles >/dev/null 2>&1; then
        systemd-tmpfiles --create /usr/lib/tmpfiles.d/@PKG@.conf >/dev/null 2>&1 || true
    else
        mkdir -p /etc/@PKG@ /var/lib/@PKG@
        chown "${USER_NAME}:${USER_NAME}" /etc/@PKG@ /var/lib/@PKG@ || true
        chmod 0755 /etc/@PKG@; chmod 0700 /var/lib/@PKG@
    fi
}

ensure_persistent_journal() {
    if [ ! -d /var/log/journal ]; then
        mkdir -p /var/log/journal 2>/dev/null || return 0
        chown root:systemd-journal /var/log/journal 2>/dev/null || true
        chmod 2755 /var/log/journal 2>/dev/null || true
        systemctl restart systemd-journald >/dev/null 2>&1 || true
    fi
}

case "$1" in
    configure)
        create_system_user
        create_dirs
        ensure_persistent_journal
        systemctl daemon-reload >/dev/null 2>&1 || true
        systemctl enable "${UNIT_NAME}" >/dev/null 2>&1 || true
        if [ -n "${2:-}" ] && systemctl is-active --quiet "${UNIT_NAME}" 2>/dev/null; then
            # 升级/重配置且服务原本在运行：平滑重启
            systemctl try-restart "${UNIT_NAME}" >/dev/null 2>&1 || true
        else
            systemctl restart "${UNIT_NAME}" >/dev/null 2>&1 || true
        fi
        ;;
    abort-upgrade)
        systemctl daemon-reload >/dev/null 2>&1 || true
        ;;
esac

exit 0
